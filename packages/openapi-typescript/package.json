{
  "name": "@zkanda/openapi-typescript",
  "description": "Convert OpenAPI 3.0 & 3.1 schemas to TypeScript",
  "version": "8.0.1",
  "author": {
    "name": "Drew Powers",
    "email": "drew@pow.rs"
  },
  "license": "MIT",
  "bin": {
    "openapi-typescript": "bin/cli.js"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./*.js": "./*.mjs",
    "./*": "./*"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/zkanda/openapi-typescript/tree/main/packages/openapi-typescript#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkanda/openapi-typescript",
    "directory": "packages/openapi-typescript"
  },
  "keywords": [
    "swagger",
    "typescript",
    "ts",
    "dts",
    "openapi",
    "codegen",
    "generation",
    "openapi 3",
    "node"
  ],
  "bugs": {
    "url": "https://github.com/zkanda/openapi-typescript/issues"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "download:schemas": "vite-node ./scripts/download-schemas.ts",
    "format": "vp fmt",
    "lint": "vp check",
    "prepack": "vp run build",
    "test": "vp run test:js && vp run test:examples && vp run test:exports",
    "test:js": "vp test run",
    "test:exports": "vp run build && attw --pack .",
    "test:examples": "tsc -p tsconfig.examples.json --noEmit",
    "update:examples": "vp run build && vp run download:schemas && vite-node ./scripts/update-examples.ts",
    "prepublish": "vp run build",
    "version": "vp run build"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "js-yaml": "^5.5.0",
    "supports-color": "^11.0.0",
    "yargs-parser": "^22.0.0"
  },
  "devDependencies": {
    "degit": "3.10.0",
    "execa": "catalog:",
    "typescript": "catalog:",
    "vite-node": "6.0.0",
    "vitest": "catalog:"
  }
}
