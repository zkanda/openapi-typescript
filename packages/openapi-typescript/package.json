{
  "name": "@zkanda/openapi-typescript",
  "description": "Convert OpenAPI 3.0 & 3.1 schemas to TypeScript",
  "version": "8.0.0",
  "author": {
    "name": "Drew Powers",
    "email": "drew@pow.rs"
  },
  "license": "MIT",
  "bin": {
    "openapi-typescript": "bin/cli.js"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./*.js": "./*.mjs",
    "./*": "./*"
  },
  "homepage": "https://github.com/zkanda/openapi-typescript/tree/main/packages/openapi-typescript#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zkanda/openapi-typescript",
    "directory": "packages/openapi-typescript"
  },
  "keywords": [
    "swagger",
    "typescript",
    "ts",
    "dts",
    "openapi",
    "codegen",
    "generation",
    "openapi 3",
    "node"
  ],
  "bugs": {
    "url": "https://github.com/zkanda/openapi-typescript/issues"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "download:schemas": "vite-node ./scripts/download-schemas.ts",
    "format": "vp fmt",
    "lint": "vp check",
    "prepack": "pnpm run build",
    "test": "pnpm run test:js && pnpm run test:examples && pnpm run test:exports",
    "test:js": "vp test run",
    "test:exports": "pnpm run build && attw --pack .",
    "test:examples": "tsc -p tsconfig.examples.json --noEmit",
    "update:examples": "pnpm run build && pnpm run download:schemas && vite-node ./scripts/update-examples.ts",
    "prepublish": "pnpm run build",
    "version": "pnpm run build"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "js-yaml": "^4.1.0",
    "supports-color": "^10.2.2",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@types/degit": "2.8.6",
    "@types/js-yaml": "4.0.9",
    "degit": "2.8.6",
    "execa": "catalog:",
    "typescript": "catalog:",
    "vite-node": "5.3.0",
    "vitest": "catalog:"
  }
}
