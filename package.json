{
  "name": "openapi-typescript-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": {
    "name": "Drew Powers",
    "email": "drew@pow.rs"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "vp run --filter \"./packages/*\" build",
    "lint": "vp run --filter \"./packages/*\" lint",
    "dev": "vp run --filter \"./packages/*\" --parallel dev",
    "format": "vp fmt",
    "test": "vp run --filter \"./packages/*\" build && vp run --filter \"./packages/*\" test",
    "test-e2e": "vp run --filter \"./packages/*\" build && vp run --filter \"./packages/*\" test-e2e",
    "size": "size-limit",
    "version": "pnpm run build && changeset version && pnpm i"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@playwright/test": "1.59.1",
    "@size-limit/preset-small-lib": "12.1.0",
    "@types/node": "25.9.8",
    "prettier": "3.8.3",
    "size-limit": "12.1.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "size-limit": [
    {
      "path": "packages/openapi-fetch/dist/index.mjs",
      "limit": "7.5 kB",
      "brotli": false
    }
  ]
}
